# ---------------------------------------------------------------------------
# Job Search Command Center — backend configuration
#
# Copy to `.env` and adjust. Every value here has a working default, so the app
# starts with no configuration at all; the calendar sections simply stay
# disconnected until OAuth credentials are filled in.
# ---------------------------------------------------------------------------

# -- app --------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
# 8000 is commonly taken by other local projects, so this app defaults to 8100.
PORT=8100

# -- database ---------------------------------------------------------------
# SQLite file, relative paths resolve from the backend/ directory.
DATABASE_URL=sqlite:///./data/jobsearch.db
# Apply migrations automatically on startup.
AUTO_MIGRATE=true

# -- authentication ---------------------------------------------------------
# Seeds the first administrator, the first time the database is created. It is
# NOT re-applied afterwards: an administrator who changes their password in
# Settings keeps the new one across restarts.
ADMIN_USERNAME=admin321
ADMIN_PASSWORD=admin321

# Recovery password. Always signs in an ADMINISTRATOR account, whatever that
# administrator's own password has been changed to, so a forgotten password
# cannot lock everyone out. It never works for a general user, and every use is
# written to the activity log.
#
# Leave unset to use the one shipped in app/core/config.py (as a bcrypt hash).
# That default is published in the README, so set your own here for anything
# reachable beyond your own machine.
# SUPER_PASSWORD=choose-your-own-recovery-password
# Set to false to remove the recovery path entirely.
SUPER_PASSWORD_ENABLED=true

# Signs the session tokens. Optional: if unset, a key is generated once and
# stored in backend/data/.secret_key so it survives restarts. Set it explicitly
# to share one key across machines, or to rotate it (which signs everyone out).
# SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=20160

# -- frontend ---------------------------------------------------------------
FRONTEND_URL=http://localhost:3100
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# -- workspace defaults -----------------------------------------------------
WORKSPACE_NAME=Job Search Command Center
DEFAULT_TIMEZONE=America/New_York

# -- calendar sync ----------------------------------------------------------
SYNC_WINDOW_PAST_DAYS=30
SYNC_WINDOW_FUTURE_DAYS=90
SYNC_INTERVAL_MINUTES=15
ENABLE_SCHEDULER=true

# -- follow-up automation ---------------------------------------------------
FOLLOWUP_AFTER_INTERVIEW_BUSINESS_DAYS=3
FOLLOWUP_CHAIN_BUSINESS_DAYS=5
WAITING_FOR_FEEDBACK_THRESHOLD_DAYS=7
NO_ACTIVITY_GHOSTED_THRESHOLD_DAYS=21

# ---------------------------------------------------------------------------
# Google Calendar
#
# 1. https://console.cloud.google.com/ -> create/select a project
# 2. APIs & Services -> Library -> enable "Google Calendar API"
# 3. APIs & Services -> OAuth consent screen -> External -> add yourself as a
#    test user (needed while the app is unverified)
# 4. Credentials -> Create credentials -> OAuth client ID -> Web application
# 5. Add the redirect URI below EXACTLY as written
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8100/api/v1/calendar/oauth/google/callback

# ---------------------------------------------------------------------------
# Microsoft Outlook / Microsoft 365
#
# 1. https://portal.azure.com/ -> Microsoft Entra ID -> App registrations -> New
# 2. Supported account types: "Accounts in any organizational directory and
#    personal Microsoft accounts" (keeps MICROSOFT_TENANT_ID=common valid)
# 3. Redirect URI: platform "Web", value exactly as below
# 4. Certificates & secrets -> New client secret -> copy the VALUE
# 5. API permissions -> Microsoft Graph -> Delegated -> User.Read,
#    Calendars.ReadWrite, offline_access -> Grant admin consent if prompted
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8100/api/v1/calendar/oauth/microsoft/callback

# ---------------------------------------------------------------------------
# Email (for AI enrichment)
#
# Gmail reuses the Google OAuth client above — just enable the Gmail API in the
# same Google Cloud project and add this redirect URI:
#   http://localhost:8100/api/v1/email/oauth/google/callback
#
# Yahoo has no OAuth for third-party apps any more, so it connects over IMAP
# with an app-specific password (Yahoo Account Security -> Generate app
# password). Add those mailboxes in Settings -> Email & AI; nothing is needed
# here. Note: app passwords are encrypted with a key derived from SECRET_KEY,
# so changing SECRET_KEY means reconnecting those mailboxes.
# ---------------------------------------------------------------------------
GMAIL_REDIRECT_URI=http://localhost:8100/api/v1/email/oauth/google/callback
# Outlook mail reuses the Microsoft OAuth client above. Add this second
# redirect URI to the SAME Azure app registration, and grant the Mail.Read
# delegated permission alongside Calendars.ReadWrite:
#   http://localhost:8100/api/v1/email/oauth/microsoft/callback
OUTLOOK_MAIL_REDIRECT_URI=http://localhost:8100/api/v1/email/oauth/microsoft/callback
# How far around a calendar event to look for related mail.
EMAIL_LOOKBACK_DAYS=45
EMAIL_LOOKAHEAD_DAYS=7
# Cap on messages sent to the model per event (controls cost).
EMAIL_MAX_MESSAGES_PER_EVENT=6
EMAIL_BODY_EXCERPT_CHARS=4000

# ---------------------------------------------------------------------------
# AI (Moonshot / Kimi)
#
# Get a key from https://platform.moonshot.ai/ . Keys are NOT interchangeable
# between the international (.ai) and China (.cn) platforms — if your key came
# from platform.moonshot.cn, set KIMI_BASE_URL=https://api.moonshot.cn/v1 .
#
# Leave KIMI_API_KEY empty and everything still works; the AI sections simply
# report that they are not configured.
# ---------------------------------------------------------------------------
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
# Alternatives: moonshot-v1-32k, moonshot-v1-128k, kimi-latest
KIMI_MODEL=kimi-k2-0711-preview
KIMI_TIMEOUT_SECONDS=60
KIMI_MAX_OUTPUT_TOKENS=1200
# Extractions at or above this confidence create records directly; below it
# they wait in the review feed as a suggestion.
AI_AUTO_CREATE_CONFIDENCE=0.75
# Master switch for anything that calls the model.
AI_ENABLED=true
